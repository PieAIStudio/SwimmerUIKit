{
  "version": 1,
  "rules": [
    {
      "paths": [
        "push-gate.template.json",
        "scoring/README.md",
        "scoring/review.schema.json",
        "scoring/settings.example.json",
        "scoring/settings.schema.json"
      ],
      "commands": [
        "pnpm pro-gov sync --check --profile engineering-runtime"
      ]
    },
    {
      "paths": [
        ".pro-gov/push-gate*",
        "lefthook.yml",
        ".githooks/**"
      ],
      "commands": [
        "node --check .pro-gov/push-gate.mjs",
        "pnpm docs:check"
      ]
    },
    {
      "paths": [
        "src/**/*.{ts,tsx,js,css,json}",
        "tests/**",
        "preview/**",
        "types/**",
        "scripts/**",
        "bin/**",
        ".storybook/**",
        "package.json",
        "pnpm-lock.yaml",
        "tsconfig*.json",
        "vite.config*.ts",
        "vitest.config.ts"
      ],
      "commands": [
        "pnpm format:check",
        "pnpm lint",
        "pnpm typecheck"
      ]
    },
    {
      "paths": [
        "src/**/*.{ts,tsx,js,css,json}",
        "tests/**",
        "package.json",
        "pnpm-lock.yaml",
        "vitest.config.ts"
      ],
      "commands": [
        "pnpm exec vitest run --project '!storybook' --project '!browser' --changed \"$PUSH_GATE_BASE\""
      ]
    },
    {
      "paths": [
        "src/**/*.{ts,tsx,js,css,json}",
        "preview/**",
        "tests/**/*.browser.test.tsx",
        "package.json",
        "pnpm-lock.yaml"
      ],
      "commands": [
        "pnpm check:styles",
        "pnpm check:themes",
        "pnpm exec vitest run --project browser tests/AccountControls.browser.test.tsx -t 'retains native disabled states'",
        "pnpm exec vitest run --project browser tests/GamePanelSystem.browser.test.tsx -t 'preserves an uncontrolled input'"
      ]
    },
    {
      "paths": [
        "src/liquid/**/*.{ts,tsx,js,css,json}",
        "src/liquid-effects/**/*.{ts,tsx,js,css,json}",
        "src/presence/**/*.{ts,tsx,js,css,json}",
        "src/tokens/**/*.{ts,tsx,js,css,json}"
      ],
      "commands": [
        "pnpm exec vitest run --project browser src/presence/LiquidReveal/LiquidReveal.browser.test.tsx -t 'zero budget and reduced motion'"
      ]
    },
    {
      "paths": [
        "src/index.ts",
        "src/*.ts",
        "package.json",
        "scripts/public-api-audit.mjs"
      ],
      "commands": [
        "pnpm api:check",
        "pnpm check:guide"
      ]
    },
    {
      "paths": [
        "bin/**"
      ],
      "commands": [
        "pnpm exec vitest run --project '!storybook' --project '!browser' tests/bin-swimmer-ui-check.test.ts"
      ]
    },
    {
      "paths": [
        "src/tokens/fonts/**/*.{ts,tsx,js,css,json}",
        "scripts/*font*"
      ],
      "commands": [
        "pnpm check:fonts"
      ]
    },
    {
      "paths": [
        ".github/**",
        "scripts/check-release-metadata.mjs"
      ],
      "commands": [
        "pnpm exec vitest run --project '!storybook' --project '!browser' tests/releaseWorkflow.test.ts"
      ]
    },
    {
      "paths": [
        "docs/**",
        "AGENTS.md",
        "CLAUDE.md",
        "README.md",
        ".doc-gov*",
        ".pro-gov/assets*",
        ".agents/skills/*",
        ".agents/manual-skills/*"
      ],
      "commands": [
        "pnpm docs:check",
        "pnpm exec vitest run --project '!storybook' --project '!browser' tests/documentationContract.test.ts"
      ]
    },
    {
      "paths": [
        ".gitignore",
        "LICENSE",
        "NOTICE",
        "CHANGELOG.md",
        ".npmrc"
      ],
      "commands": [],
      "reason": "Repository metadata/legal/history; no runtime change."
    },
    {
      "paths": [
        "src/containers/HudActions/**/*.{ts,tsx,js,css,json}"
      ],
      "commands": [
        "pnpm exec vitest run --project browser src/containers/HudActions/HudActions.browser.test.tsx"
      ]
    },
    {
      "paths": [
        "src/controls/Button/**/*.{ts,tsx,js,css,json}"
      ],
      "commands": [
        "pnpm exec vitest run --project browser src/controls/Button/Button.browser.test.tsx src/controls/Button/contour-identity.browser.test.tsx src/controls/Button/danger.browser.test.tsx"
      ]
    },
    {
      "paths": [
        "src/controls/DropletSurface/**/*.{ts,tsx,js,css,json}"
      ],
      "commands": [
        "pnpm exec vitest run --project browser src/controls/DropletSurface/DropletSurface.browser.test.tsx",
        "pnpm exec vitest run --project browser src/feedback/HowToPanel/HowToPanel.browser.test.tsx"
      ]
    },
    {
      "paths": [
        "src/controls/LanguageMenu/**/*.{ts,tsx,js,css,json}"
