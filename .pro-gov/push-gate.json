    {
      "paths": [
        "tests/surfaceTokens.browser.test.tsx"
      ],
      "commands": [
        "pnpm exec vitest run --project browser tests/surfaceTokens.browser.test.tsx"
      ]
    },
    {
      "paths": [
        "src/**/*.md"
      ],
      "commands": [
        "pnpm check:guide"
      ]
    }
  ],
  "blindSpots": [
    "Unit selection excludes Storybook/browser projects and uses Vitest's changed static-import graph; this project selector was validated with vitest list.",
    "Source browser coverage is a fixed disabled-control/modal/reduced-motion smoke plus colocated component browser files; global tokens do not run every component/theme or all Storybook stories.",
    "No independent visual score, whole Storybook build, packed/Next consumer, real app integration or publication is claimed by this ordinary push gate."
  ]
}
